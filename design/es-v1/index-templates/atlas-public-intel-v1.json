{
  "index_patterns": ["atlas-public-intel-v1-*"],
  "priority": 500,
  "version": 1,
  "_meta": {"owner": "atlas", "schema_version": "1.0", "document_grain": "one public intelligence record"},
  "template": {
    "settings": {
      "number_of_shards": 2,
      "number_of_replicas": 1,
      "refresh_interval": "10s",
      "index.mapping.total_fields.limit": 500
    },
    "mappings": {
      "dynamic": "strict",
      "_routing": {"required": true},
      "properties": {
        "intel_id": {"type": "keyword"},
        "atlas_company_id": {"type": "keyword"},
        "company": {
          "properties": {
            "name": {"type": "text", "fields": {"raw": {"type": "keyword", "ignore_above": 256}}},
            "credit_code": {"type": "keyword"},
            "source_company_id": {"type": "keyword"}
          }
        },
        "intel_type": {"type": "keyword"},
        "title": {"type": "text", "fields": {"raw": {"type": "keyword", "ignore_above": 512}}},
        "summary": {"type": "text"},
        "content": {"type": "text"},
        "source_name": {"type": "keyword", "ignore_above": 256},
        "source_url": {"type": "keyword", "index": false},
        "source_domain": {"type": "keyword"},
        "author": {"type": "keyword", "ignore_above": 256},
        "published_at": {"type": "date", "format": "strict_date_optional_time||yyyy-MM-dd"},
        "captured_at": {"type": "date", "format": "strict_date_optional_time"},
        "classification": {"type": "keyword"},
        "search": {
          "properties": {
            "provider": {"type": "keyword"},
            "query": {"type": "text", "fields": {"raw": {"type": "keyword", "ignore_above": 512}}},
            "rank": {"type": "integer"},
            "result_type": {"type": "keyword"}
          }
        },
        "sentiment": {
          "properties": {
            "label": {"type": "keyword"},
            "score": {"type": "scaled_float", "scaling_factor": 10000},
            "model_version": {"type": "keyword"}
          }
        },
        "entity_match": {
          "properties": {
            "status": {"type": "keyword"},
            "confidence": {"type": "scaled_float", "scaling_factor": 10000},
            "matched_by": {"type": "keyword"},
            "explanation": {"type": "text"}
          }
        },
        "evidence": {
          "properties": {
            "grade": {"type": "keyword"},
            "verification_status": {"type": "keyword"},
            "content_hash": {"type": "keyword"},
            "raw_uri": {"type": "keyword", "index": false},
            "accessible": {"type": "boolean"}
          }
        },
        "source": {
          "properties": {
            "system": {"type": "keyword"},
            "table": {"type": "keyword"},
            "record_id": {"type": "keyword"},
            "company_id": {"type": "keyword"},
            "source_updated_at": {"type": "date", "format": "strict_date_optional_time"}
          }
        },
        "ingest": {
          "properties": {
            "batch_id": {"type": "keyword"},
            "schema_version": {"type": "keyword"},
            "dedupe_key": {"type": "keyword"},
            "ingested_at": {"type": "date", "format": "strict_date_optional_time"},
            "deleted": {"type": "boolean"}
          }
        },
        "extensions": {"type": "flattened"}
      }
    }
  }
}
