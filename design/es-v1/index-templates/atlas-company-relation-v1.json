{
  "index_patterns": ["atlas-company-relation-v1-*"],
  "priority": 500,
  "version": 1,
  "_meta": {"owner": "atlas", "schema_version": "1.0", "document_grain": "one company relation"},
  "template": {
    "settings": {
      "number_of_shards": 2,
      "number_of_replicas": 1,
      "refresh_interval": "30s",
      "index.mapping.total_fields.limit": 400
    },
    "mappings": {
      "dynamic": "strict",
      "_routing": {"required": true},
      "properties": {
        "relation_id": {"type": "keyword"},
        "atlas_company_id": {"type": "keyword"},
        "company": {
          "properties": {
            "name": {"type": "text", "fields": {"raw": {"type": "keyword", "ignore_above": 256}}},
            "credit_code": {"type": "keyword"},
            "source_company_id": {"type": "keyword"}
          }
        },
        "relation_type": {"type": "keyword"},
        "direction": {"type": "keyword"},
        "status": {"type": "keyword"},
        "valid_from": {"type": "date", "format": "strict_date_optional_time||yyyy-MM-dd"},
        "valid_to": {"type": "date", "format": "strict_date_optional_time||yyyy-MM-dd"},
        "subject": {
          "properties": {
            "entity_id": {"type": "keyword"},
            "entity_type": {"type": "keyword"},
            "name": {"type": "text", "fields": {"raw": {"type": "keyword", "ignore_above": 256}}},
            "credit_code": {"type": "keyword"},
            "position": {"type": "keyword"},
            "brief": {"type": "text"},
            "legal_representative": {"type": "text", "fields": {"raw": {"type": "keyword", "ignore_above": 128}}}
          }
        },
        "ownership": {
          "properties": {
            "ratio_raw": {"type": "keyword", "ignore_above": 64},
            "ratio_percent": {"type": "scaled_float", "scaling_factor": 10000},
            "registered_amount_raw": {"type": "keyword", "ignore_above": 128},
            "registered_amount": {"type": "scaled_float", "scaling_factor": 100},
            "paid_amount_raw": {"type": "keyword", "ignore_above": 128},
            "paid_amount": {"type": "scaled_float", "scaling_factor": 100},
            "currency": {"type": "keyword"},
            "unit": {"type": "keyword"},
            "capital_date": {"type": "date", "format": "strict_date_optional_time||yyyy-MM-dd"}
          }
        },
        "source": {
          "properties": {
            "system": {"type": "keyword"},
            "table": {"type": "keyword"},
            "record_id": {"type": "keyword"},
            "company_id": {"type": "keyword"},
            "source_updated_at": {"type": "date", "format": "strict_date_optional_time"}
          }
        },
        "ingest": {
          "properties": {
            "batch_id": {"type": "keyword"},
            "schema_version": {"type": "keyword"},
            "content_hash": {"type": "keyword"},
            "dedupe_key": {"type": "keyword"},
            "ingested_at": {"type": "date", "format": "strict_date_optional_time"},
            "deleted": {"type": "boolean"}
          }
        },
        "extensions": {"type": "flattened"}
      }
    }
  }
}
