ATLAS_DB_USERNAME=atlas
ATLAS_DB_PASSWORD=replace-with-a-local-secret
ATLAS_SERVICE_PORT=8080
ATLAS_CONSOLE_PORT=3000
ATLAS_PUBLIC_API_BASE=http://localhost:8080
ATLAS_ALLOWED_ORIGINS=http://localhost:3000

# Local/dev keeps direct browser access. Production must use PROXY and place
# the service behind an authenticated gateway that injects identity headers.
ATLAS_SECURITY_MODE=local
# Required in PROXY mode; use a secret manager and at least 32 random characters.
ATLAS_SECURITY_PROXY_SECRET=

# Optional single-node Elasticsearch used only for schema/query validation.
ATLAS_ES_VERSION=9.4.2
ATLAS_ES_PORT=9200
ATLAS_ES_MEMORY_LIMIT=4g
ATLAS_ES_JAVA_OPTS=-Xms2g -Xmx2g
ATLAS_DATA_PROVIDER=offline
ATLAS_ES_BASE_URL=http://elasticsearch-dev:9200
ATLAS_ES_CONNECT_TIMEOUT=3s
ATLAS_ES_REQUEST_TIMEOUT=15s
ATLAS_ES_MAX_RECORDS=5000
ATLAS_ES_COMPANY_ALIAS=atlas-company-read
ATLAS_ES_EVENT_ALIAS=atlas-company-event-read
ATLAS_ES_PUBLIC_INTEL_ALIAS=atlas-public-intel-read
ATLAS_ES_CONTACT_ALIAS=atlas-company-contact-read
ATLAS_ES_RELATION_ALIAS=atlas-company-relation-read

# Optional report-before-generation company refresh. Keep disabled until the
# controlled provider credentials and outbound connectivity are validated.
ATLAS_COMPANY_REFRESH_ENABLED=false
ATLAS_COMPANY_REFRESH_BASE_URL=https://openapi.xiaolanben.com/api/
ATLAS_COMPANY_REFRESH_ACCESS_ID=
ATLAS_COMPANY_REFRESH_ACCESS_TOKEN=
ATLAS_COMPANY_REFRESH_CONNECT_TIMEOUT=5s
ATLAS_COMPANY_REFRESH_REQUEST_TIMEOUT=30s
ATLAS_COMPANY_REFRESH_MAX_ATTEMPTS=3
ATLAS_COMPANY_REFRESH_PAGE_SIZE=100
ATLAS_COMPANY_REFRESH_MAX_RECORDS_PER_CATEGORY=5000

# Tavily Search. Enable only after TAVILY_API_KEY is available.
ATLAS_SEARCH_PRIMARY_ENABLED=false
ATLAS_SEARCH_PRIMARY_PROVIDER_TYPE=TAVILY
ATLAS_SEARCH_PRIMARY_BASE_URL=https://api.tavily.com
ATLAS_SEARCH_PRIMARY_PATH=/search
TAVILY_API_KEY=
ATLAS_SEARCH_PRIMARY_SEARCH_DEPTH=basic
ATLAS_SEARCH_PRIMARY_TOPIC=general
ATLAS_SEARCH_PRIMARY_MAX_RESULTS=10
ATLAS_SEARCH_PRIMARY_MAX_ATTEMPTS=3
ATLAS_SEARCH_PRIMARY_RETRY_BACKOFF=250ms
ATLAS_SEARCH_PRIMARY_CIRCUIT_FAILURE_THRESHOLD=5
ATLAS_SEARCH_PRIMARY_CIRCUIT_OPEN_DURATION=30s

ATLAS_SEARCH_LLM_ENABLED=false
ATLAS_SEARCH_LLM_BASE_URL=https://llm-gateway.example/v1
ATLAS_SEARCH_LLM_API_KEY=
ATLAS_SEARCH_LLM_MAX_ATTEMPTS=2
ATLAS_SEARCH_LLM_RETRY_BACKOFF=500ms
ATLAS_SEARCH_LLM_CIRCUIT_FAILURE_THRESHOLD=3
ATLAS_SEARCH_LLM_CIRCUIT_OPEN_DURATION=60s

# Published OpenAI-compatible semantic model (intent + evidence assistance).
# Store the real key only in the deployment .env file.
ATLAS_LLM_API_KEY=
# Number of background evidence-review jobs allowed to call the model concurrently.
ATLAS_MODEL_REVIEW_CONCURRENCY=1
